# Copy to .env and edit. Compose reads this automatically.

# Timezone for the cost "today"/daily rollups (so they roll over at YOUR local midnight, not UTC).
# Use a tz database name, e.g. America/Chicago, Europe/London. Defaults to UTC if unset.
TZ=UTC

# Label shown on the dashboard for this machine (the container can't see the real host name).
CC_HOST=claude-host

# Which Claude account this host uses (drives the per-account rate-limit gauges + card tags). Normally
# auto-detected: the statusline hook reads ~/.claude.json host-side, and a native watcher falls back to
# reading it directly. Set this ONLY to override — e.g. on the dashboard CONTAINER's local-scan host, where
# ~/.claude.json isn't mounted in (by design — keeps OAuth tokens out of the container) and you'd otherwise
# want idle sessions tagged too. Leave blank to auto-detect.
# CC_ACCOUNT=you@example.com

# Port to expose the dashboard on.
CC_PORT=8099

# Comma-separated model-id substrings to treat as a 1M-context window
# (transcripts omit the [1m] marker). Leave blank if you don't use 1M models.
CC_WINDOW_1M_MODELS=claude-opus-4-8

# Override only if your transcripts live somewhere other than ~/.claude/projects
# CC_PROJECTS_DIR=/home/youruser/.claude/projects

# --- Basic security (optional; Local-First default is open on a trusted LAN) ---
# Set a PIN to require unlock for the dashboard UI (first visit prompts, then a long-lived cookie).
# CC_ACCESS_PIN=1234
# Set a shared token to require remote watchers to send  X-CC-Token: <token>  on /ingest.
# CC_INGEST_TOKEN=change-me-long-random

# --- Answer-from-phone (E5) ---
# Tap a waiting session on your phone and type a reply -> injected into its tmux pane via the
# cc-responder service (./deploy-responder.sh). This is RCE into your shell, so it is REFUSED
# unless CC_ACCESS_PIN is set above. Set CC_INGEST_TOKEN too so the responder authenticates.
# The responder reads CC_HOST + CC_INGEST_TOKEN from THIS file. Only sessions running inside tmux
# (with the state hook recording their pane) are answerable.
