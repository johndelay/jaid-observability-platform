[Unit]
Description=cc-observability responder (answer-from-phone; injects replies into tmux)
After=cc-collector.service network.target
Wants=cc-collector.service

[Service]
Type=simple
WorkingDirectory=%h/git/jaid-observability-platform
# Shares the SAME .env as the Docker collector, so CC_HOST + CC_INGEST_TOKEN match automatically.
# CC_DASHBOARD_URL defaults to http://localhost:8099. Answer-from-phone only does anything once
# CC_ACCESS_PIN is set on the server (the server refuses /reply without a PIN — inject = shell RCE).
EnvironmentFile=-%h/git/jaid-observability-platform/.env
ExecStart=/usr/bin/python3 %h/git/jaid-observability-platform/responder.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
