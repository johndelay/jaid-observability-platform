[Unit]
Description=cc-observability transcript watcher
After=cc-collector.service
Wants=cc-collector.service

[Service]
Type=simple
WorkingDirectory=%h/git/jaid-observability-platform
Environment=CC_COLLECTOR_URL=http://localhost:8099/ingest
ExecStart=/usr/bin/python3 %h/git/jaid-observability-platform/watcher.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
