#!/usr/bin/env bash
# pre-commit — refuse direct commits on `main`.
#
# Branch workflow for this repo: work happens on `development`; `main` only ever
# receives `git merge --no-ff development` (a release/merge commit). This hook stops
# the easy mistake of committing a change straight onto `main` and pushing it.
#
# A commit that genuinely belongs on `main` (a release/manifest bump, a merge) bypasses
# the guard with:   git commit --no-verify
#
# Install via:  scripts/install-git-hooks.sh
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" = "main" ]; then
  exec >&2
  echo "✋ Refusing to commit directly on main."
  echo "   Workflow: commit on 'development'; main receives '--no-ff' merges only."
  echo "   Switch:   git checkout development"
  echo "   Truly a release/merge commit for main? re-run with: git commit --no-verify"
  exit 1
fi
exit 0
